# Keep manifest-hashed fake object fixtures byte-stable across platforms.
wom-kit/examples/fake-life-archive/objects/sample/*.txt text eol=lf
wom-kit/examples/fake-life-archive/objects/manifests/*.jsonl text eol=lf

# Keep source-bound Python package resources byte-stable across platforms.
wom-kit/schemas/** text eol=lf
wom-kit/templates/** text eol=lf
wom-kit/zettel-kasten/** text eol=lf
wom-kit/docs/releases/*.md text eol=lf
wom-kit/src/wom_kit/_resources/** text eol=lf
wom-kit/project-runtime-policy.json text eol=lf
wom-kit/project-runtime-supply-lock-v*.json text eol=lf
wom-kit/tests/fixtures/unicode-17.0.0/*.txt text eol=lf
wom-kit/tests/fixtures/v0.3.294-surface-baseline.json text eol=lf

# The project-scoped runtime bridge verifies executed source bytes against the
# exact release tag, so these Python sources must materialize identically on
# Windows and POSIX checkouts.
wom-kit/cli/archive.py text eol=lf
wom-kit/src/wom_kit/**/*.py text eol=lf
