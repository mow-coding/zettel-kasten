{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wom-kit/markup-reference-binding-manifest/v0.1",
  "title": "WOM-kit reviewed markup reference binding manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "archive_id", "bindings"],
  "properties": {
    "schema": {"const": "wom-kit/markup-reference-binding-manifest/v0.1"},
    "archive_id": {"type": "string", "minLength": 1},
    "bindings": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["zettel_id", "tag_sha256", "binding_kind", "binding_id"],
        "properties": {
          "zettel_id": {"type": "string", "pattern": "^zet_[A-Za-z0-9][A-Za-z0-9_-]{0,159}$"},
          "tag_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "binding_kind": {"enum": ["external_locator", "zettel_edge"]},
          "binding_id": {
            "type": "string",
            "pattern": "^(?:locator:sha256:|edge:)[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
