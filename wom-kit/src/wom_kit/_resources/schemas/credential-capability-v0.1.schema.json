{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/wom-kit/credential-capability-v0.1.schema.json",
  "title": "WOM Credential Capability v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "capability_id",
    "provider",
    "operation",
    "consumer",
    "approval_decision",
    "reviewed_by",
    "allowed_methods",
    "endpoint_classes",
    "required_registered_capabilities",
    "request_sha256",
    "plan_sha256",
    "scopes",
    "issued_at",
    "expires_at",
    "ttl_seconds",
    "max_uses",
    "max_provider_requests"
  ],
  "properties": {
    "schema": {
      "const": "wom-kit/credential-capability/v0.1"
    },
    "capability_id": {
      "type": "string",
      "pattern": "^cap_[0-9a-f]{32}$"
    },
    "provider": {
      "const": "notion"
    },
    "operation": {
      "const": "notion_page_recovery_read"
    },
    "consumer": {
      "const": "wom:workflow:notion-page-recovery"
    },
    "approval_decision": {
      "const": "approve_once"
    },
    "reviewed_by": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._@:+-]{0,127}$"
    },
    "allowed_methods": {
      "const": [
        "GET"
      ]
    },
    "endpoint_classes": {
      "const": [
        "retrieve_page",
        "retrieve_page_as_markdown"
      ]
    },
    "required_registered_capabilities": {
      "const": [
        "read_content",
        "retrieve_page",
        "retrieve_page_as_markdown"
      ]
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/scope"
      }
    },
    "issued_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "expires_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "ttl_seconds": {
      "type": "integer",
      "minimum": 30,
      "maximum": 3600
    },
    "max_uses": {
      "type": "integer",
      "const": 1
    },
    "max_provider_requests": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5000000
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credential_id",
        "workspace_fingerprint",
        "scope_receipt_sha256",
        "revision"
      ],
      "properties": {
        "credential_id": {
          "type": "string",
          "pattern": "^cred_[A-Za-z0-9_-]{16,96}$"
        },
        "workspace_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "scope_receipt_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$"
        }
      }
    }
  }
}
