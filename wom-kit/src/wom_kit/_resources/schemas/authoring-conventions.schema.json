{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wom-kit/authoring-conventions/v0.1",
  "title": "WOM archive-specific human authoring conventions",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "body_rules"],
  "properties": {
    "schema": {"const": "wom-kit/authoring-conventions/v0.1"},
    "language": {"type": "string", "minLength": 2, "maxLength": 40},
    "title_rules": {
      "type": "array",
      "maxItems": 100,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "body_rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "required_sections": {
      "type": "array",
      "maxItems": 100,
      "items": {"type": "string", "minLength": 1, "maxLength": 120}
    },
    "forbidden_body_content": {
      "type": "array",
      "maxItems": 100,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "examples": {
      "type": "array",
      "maxItems": 20,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    }
  }
}
