{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wom-kit/source-intake-batch-request/v0.1",
  "title": "WOM source intake batch request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "batch_id", "items"],
  "properties": {
    "schema": {"const": "wom-kit/source-intake-batch-request/v0.1"},
    "batch_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,199}$"},
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "local_path"],
        "properties": {
          "item_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,199}$"},
          "local_path": {"type": "string", "minLength": 1, "maxLength": 4096},
          "source_role": {
            "type": "string",
            "enum": ["attachment", "context", "derived_context", "primary_source"]
          },
          "title": {"type": "string", "minLength": 1, "maxLength": 500},
          "mime": {"type": "string", "minLength": 1, "maxLength": 200}
        }
      }
    }
  }
}
