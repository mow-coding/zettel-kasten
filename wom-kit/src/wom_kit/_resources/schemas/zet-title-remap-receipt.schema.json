{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wom-kit/zet-title-remap-receipt/v0.1",
  "title": "WOM-kit zet title remap receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "action",
    "status",
    "applied_at",
    "archive_id",
    "proposal_sha256",
    "plan_digest",
    "write_plan_digest",
    "reviewed_by",
    "human_affirmation",
    "item_count",
    "items",
    "mutation_contract",
    "privacy_guards"
  ],
  "properties": {
    "schema": {"const": "wom-kit/zet-title-remap-receipt/v0.1"},
    "action": {"const": "zet_title_remap_write"},
    "status": {"const": "applied"},
    "applied_at": {"type": "string", "minLength": 1},
    "archive_id": {"type": "string", "minLength": 1},
    "proposal_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "plan_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "write_plan_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "reviewed_by": {"type": "string", "minLength": 1},
    "human_affirmation": {"const": "all_proposed_titles_reviewed"},
    "item_count": {"type": "integer", "minimum": 1, "maximum": 5000},
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {"$ref": "#/$defs/item"}
    },
    "mutation_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_replaced",
        "body_bytes_preserved",
        "other_frontmatter_semantics_preserved",
        "updated_at_changed",
        "prior_byte_snapshots_verified_before_first_canonical_write",
        "rollback_on_runtime_failure",
        "crash_recovery_journal_written"
      ],
      "properties": {
        "field_replaced": {"const": "frontmatter.title"},
        "body_bytes_preserved": {"const": true},
        "other_frontmatter_semantics_preserved": {"const": true},
        "updated_at_changed": {"const": false},
        "prior_byte_snapshots_verified_before_first_canonical_write": {"const": true},
        "rollback_on_runtime_failure": {"const": true},
        "crash_recovery_journal_written": {"const": true}
      }
    },
    "privacy_guards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "old_title_text_stored_in_receipt",
        "new_title_text_stored_in_receipt",
        "body_text_stored_in_receipt",
        "provider_api_called",
        "model_called",
        "secret_store_or_environment_read"
      ],
      "properties": {
        "old_title_text_stored_in_receipt": {"const": false},
        "new_title_text_stored_in_receipt": {"const": false},
        "body_text_stored_in_receipt": {"const": false},
        "provider_api_called": {"const": false},
        "model_called": {"const": false},
        "secret_store_or_environment_read": {"const": false}
      }
    }
  },
  "$defs": {
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_id",
        "logical_key",
        "size_bytes",
        "mime",
        "stored_sha256_verified",
        "manifest_registered"
      ],
      "properties": {
        "object_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "logical_key": {"type": "string", "pattern": "^objects/sha256/[0-9a-f]{2}/[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1, "maximum": 16777216},
        "mime": {"const": "text/markdown"},
        "stored_sha256_verified": {"const": true},
        "manifest_registered": {"const": true}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_index",
        "zettel_id",
        "canonical_path",
        "basis",
        "before_file_sha256",
        "after_file_sha256",
        "before_title_sha256",
        "after_title_sha256",
        "body_sha256",
        "before_snapshot"
      ],
      "properties": {
        "row_index": {"type": "integer", "minimum": 0},
        "zettel_id": {"type": "string", "pattern": "^zet_[A-Za-z0-9][A-Za-z0-9_-]{0,159}$"},
        "canonical_path": {"type": "string", "pattern": "^zettels/.+\\.md$"},
        "basis": {"enum": ["source_export_property", "human_written"]},
        "before_file_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "after_file_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "before_title_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "after_title_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "body_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "before_snapshot": {"$ref": "#/$defs/snapshot"}
      }
    }
  }
}
