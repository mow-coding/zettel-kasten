{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wom-kit/external-locator-revert-receipt/v0.1",
  "title": "WOM-kit external locator exact-state revert receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "archive_id", "zettel_id", "source_receipt_sha256", "revert_plan_sha256", "restore_action", "restored_record_sha256", "reviewed_by", "created_at"],
  "properties": {
    "schema": {"const": "wom-kit/external-locator-revert-receipt/v0.1"},
    "archive_id": {"type": "string", "minLength": 1},
    "zettel_id": {"type": "string", "pattern": "^zet_[A-Za-z0-9][A-Za-z0-9_-]{0,159}$"},
    "source_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "revert_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "restore_action": {"enum": ["removed_new_record", "restored_previous_record"]},
    "restored_record_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "reviewed_by": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1}
  }
}
