{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wom-kit/source-intake-batch-receipt/v0.1",
  "title": "WOM source intake batch receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "archive_id",
    "batch_id",
    "source_intake_batch_plan_sha256",
    "reviewed_by",
    "item_count",
    "items"
  ],
  "properties": {
    "schema": {"const": "wom-kit/source-intake-batch-receipt/v0.1"},
    "archive_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "batch_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,199}$"},
    "source_intake_batch_plan_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "reviewed_by": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+-]{0,199}$"},
    "item_count": {"type": "integer", "minimum": 1, "maximum": 1000},
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "source_intake_plan_sha256", "source_intake_receipt_path"],
        "properties": {
          "item_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,199}$"},
          "source_intake_plan_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "source_intake_receipt_path": {
            "type": "string",
            "pattern": "^receipts/sources/source-intake-[0-9a-f]{16}\\.source-intake-plan\\.json$"
          }
        }
      }
    }
  }
}
