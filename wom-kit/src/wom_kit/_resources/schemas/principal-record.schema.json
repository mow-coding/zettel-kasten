{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wom.example/schemas/principal-record.schema.json",
  "title": "WOM Registered Principal Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "principal_id",
    "kind",
    "display_name",
    "status",
    "created_at",
    "reviewed_by"
  ],
  "properties": {
    "schema": {
      "const": "wom-kit/principal-record/v0.1"
    },
    "principal_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,31}:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "kind": {
      "enum": [
        "person",
        "family",
        "household",
        "child",
        "company",
        "team",
        "project",
        "role",
        "client",
        "future_successor"
      ]
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "status": {
      "const": "active"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  }
}
