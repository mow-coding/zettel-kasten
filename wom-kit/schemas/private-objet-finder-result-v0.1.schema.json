    "resultItem": {
      "type": "object",
      "required": [
        "object_id",
        "safe_label",
        "matched_alias_kinds",
        "matched_alias_count",
        "evidence"
      ],
      "properties": {
        "object_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "safe_label": {
          "allOf": [
            {
              "$ref": "objet-safe-label-projection-v0.1.schema.json#/$defs/privateProjection"
            },
            {
              "properties": {
                "audience": {
                  "const": "private_archive"
                }
              },
              "required": [
                "audience"
              ]
            }
          ]
        },
        "matched_alias_kinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "filename_canonical_caseless",
              "filename_separator_folded",
              "stem_canonical_caseless",
              "stem_separator_folded",
              "extension_ascii_lower"
            ]
          }
        },
        "matched_alias_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 320
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      },
      "additionalProperties": false
    },
