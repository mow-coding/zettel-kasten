{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wom-kit/relation-candidate-plan/v0.1",
  "title": "WOM-kit deterministic local relation candidate plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "archive_id", "source_zettel_id", "source_sha256", "max_candidates", "include_rejected", "candidates"],
  "properties": {
    "schema": {"const": "wom-kit/relation-candidate-plan/v0.1"},
    "archive_id": {"type": "string", "minLength": 1},
    "source_zettel_id": {"type": ["string", "null"]},
    "source_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "max_candidates": {"type": "integer", "minimum": 1, "maximum": 500},
    "include_rejected": {"type": "boolean"},
    "candidates": {"type": "array", "maxItems": 500, "items": {"type": "object"}}
  }
}
