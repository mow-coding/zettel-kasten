{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wom-kit/private-objet-source-metadata-intake/v0.1",
  "title": "WOM-kit private objet source metadata intake v0.1",
  "type": "object",
  "required": [
    "schema",
    "object_id",
    "privacy_class",
    "name_observation",
    "media_observation",
    "size_bytes_observed",
    "size_bytes_basis",
    "source_provenance",
    "review_evidence"
  ],
  "properties": {
    "schema": {
      "const": "wom-kit/private-objet-source-metadata-intake/v0.1"
    },
    "object_id": {
      "$ref": "#/$defs/sha256"
    },
    "privacy_class": {
      "enum": [
        "private_archive",
        "restricted"
      ]
    },
    "name_observation": {
      "type": "object",
      "required": [
        "original_filename",
        "name_input_profile"
      ],
      "properties": {
        "original_filename": {
          "$ref": "#/$defs/scalar512"
        },
        "name_input_profile": {
          "enum": [
            "literal_unicode",
            "utf8_percent_encoded_component"
          ]
        }
      },
      "additionalProperties": false
    },
    "media_observation": {
      "type": "object",
      "required": [
        "value",
        "basis"
      ],
      "properties": {
        "value": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/mediaType"
            }
          ]
        },
        "basis": {
          "enum": [
            "source_declared",
            "unknown"
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "basis": {
              "const": "source_declared"
            },
            "value": {
              "$ref": "#/$defs/mediaType"
            }
          },
          "required": [
            "basis",
            "value"
          ]
        },
        {
          "properties": {
            "basis": {
              "const": "unknown"
            },
            "value": {
              "const": null
            }
          },
          "required": [
            "basis",
            "value"
          ]
        }
      ],
      "additionalProperties": false
    },
    "size_bytes_observed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "size_bytes_basis": {
      "const": "source_observed"
    },
    "source_provenance": {
      "$ref": "#/$defs/sourceProvenance"
    },
    "review_evidence": {
      "type": "object",
      "required": [
        "review_evidence_sha256",
        "review_status"
      ],
      "properties": {
        "review_evidence_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "review_status": {
          "const": "human_reviewed"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "scalar512": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^(?![\\s\\S]*[\\uD800-\\uDFFF])[\\s\\S]*$"
    },
    "opaqueSourceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?![\\s\\S]*[\\uD800-\\uDFFF])[\\s\\S]*$"
    },
    "mediaType": {
      "type": "string",
      "minLength": 3,
      "maxLength": 127,
      "pattern": "^[a-z0-9][a-z0-9!#$&^_.+\\-]{0,126}/[a-z0-9][a-z0-9!#$&^_.+\\-]{0,126}$"
    },
    "capturedAt": {
      "type": "string",
      "minLength": 20,
      "maxLength": 64,
      "pattern": "^(?!0000)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
      "format": "date-time"
    },
    "sourceProvenance": {
      "type": "object",
      "required": [
        "source_system",
        "source_record_id",
        "source_attachment_id",
        "source_snapshot_sha256",
        "observation_evidence_sha256",
        "evidence_kind",
        "captured_at"
      ],
      "properties": {
        "source_system": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,63})$"
        },
        "source_record_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/opaqueSourceId"
            }
          ]
        },
        "source_attachment_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/opaqueSourceId"
            }
          ]
        },
        "source_snapshot_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "observation_evidence_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "evidence_kind": {
          "enum": [
            "source_record_field",
            "source_attachment_metadata",
            "source_snapshot_extract"
          ]
        },
        "captured_at": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/capturedAt"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence_kind": {
                "const": "source_record_field"
              }
            },
            "required": [
              "evidence_kind"
            ]
          },
          "then": {
            "properties": {
              "source_record_id": {
                "$ref": "#/$defs/opaqueSourceId"
              },
              "source_attachment_id": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence_kind": {
                "const": "source_attachment_metadata"
              }
            },
            "required": [
              "evidence_kind"
            ]
          },
          "then": {
            "properties": {
              "source_attachment_id": {
                "$ref": "#/$defs/opaqueSourceId"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
