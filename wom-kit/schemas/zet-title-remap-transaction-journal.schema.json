{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wom-kit/zet-title-remap-transaction-journal/v0.1",
  "title": "WOM-kit zet title remap transaction journal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "action",
    "status",
    "operation",
    "prepared_at",
    "archive_id",
    "proposal_sha256",
    "plan_digest",
    "write_plan_digest",
    "reviewed_by",
    "human_affirmation",
    "final_receipt_path",
    "item_count",
    "items",
    "recovery_contract",
    "privacy_guards",
    "journal_digest"
  ],
  "properties": {
    "schema": {"const": "wom-kit/zet-title-remap-transaction-journal/v0.1"},
    "action": {"const": "zet_title_remap_transaction"},
    "status": {"const": "prepared"},
    "operation": {"const": "apply"},
    "prepared_at": {"type": "string", "minLength": 1},
    "archive_id": {"type": "string", "minLength": 1},
    "proposal_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "plan_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "write_plan_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "reviewed_by": {"type": "string", "minLength": 1},
    "human_affirmation": {"const": "all_proposed_titles_reviewed"},
    "final_receipt_path": {
      "type": "string",
      "pattern": "^receipts/revisions/title-remap/[0-9a-f]{64}\\.zet-title-remap\\.json$"
    },
    "item_count": {"type": "integer", "minimum": 1, "maximum": 5000},
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "$ref": "zet-title-remap-receipt.schema.json#/$defs/item"
      }
    },
    "recovery_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "journal_published_before_first_canonical_write",
        "current_state_inferred_from_participant_hashes",
        "prior_byte_snapshots_verified_before_journal",
        "automatic_resume_implemented",
        "automatic_rollback_after_hard_exit_implemented"
      ],
      "properties": {
        "journal_published_before_first_canonical_write": {"const": true},
        "current_state_inferred_from_participant_hashes": {"const": true},
        "prior_byte_snapshots_verified_before_journal": {"const": true},
        "automatic_resume_implemented": {"const": false},
        "automatic_rollback_after_hard_exit_implemented": {"const": false}
      }
    },
    "privacy_guards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "old_title_text_stored",
        "new_title_text_stored",
        "body_text_stored",
        "contains_private_zettel_ids_and_paths",
        "provider_api_called",
        "model_called",
        "secret_store_or_environment_read"
      ],
      "properties": {
        "old_title_text_stored": {"const": false},
        "new_title_text_stored": {"const": false},
        "body_text_stored": {"const": false},
        "contains_private_zettel_ids_and_paths": {"const": true},
        "provider_api_called": {"const": false},
        "model_called": {"const": false},
        "secret_store_or_environment_read": {"const": false}
      }
    },
    "journal_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
