{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "notion-property-backfill-acceptance-v0.1.schema.json",
  "title": "WOM-kit Notion property backfill source-completeness acceptance",
  "description": "A content-free, operator-owned inventory gate for one local Notion property recovery source.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mirror_snapshot_sha256",
    "mirror_page_count",
    "source_property_count",
    "populated_property_count",
    "indeterminate_property_count",
    "opaque_property_count",
    "source_format_page_counts",
    "legacy_record_map_root_page_counts",
    "normalized_source_id_page_counts"
  ],
  "properties": {
    "schema_version": {
      "const": "wom-kit/notion-property-backfill-acceptance/v0.1"
    },
    "mirror_snapshot_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "mirror_page_count": {
      "type": "integer",
      "minimum": 1
    },
    "source_property_count": {"type": "integer", "minimum": 0},
    "populated_property_count": {"type": "integer", "minimum": 0},
    "indeterminate_property_count": {"type": "integer", "minimum": 0},
    "opaque_property_count": {"type": "integer", "minimum": 0},
    "source_format_page_counts": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "notion_api_page": {"type": "integer", "minimum": 0},
        "legacy_record_map": {"type": "integer", "minimum": 0}
      }
    },
    "legacy_record_map_root_page_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["properties_present", "properties_absent"],
      "properties": {
        "properties_present": {"type": "integer", "minimum": 0},
        "properties_absent": {"type": "integer", "minimum": 0}
      }
    },
    "normalized_source_id_page_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unique", "duplicate", "invalid"],
      "properties": {
        "unique": {"type": "integer", "minimum": 0},
        "duplicate": {"type": "integer", "minimum": 0},
        "invalid": {"type": "integer", "minimum": 0}
      }
    },
    "populated_page_counts_by_property_type": {
      "type": "object",
      "propertyNames": {"minLength": 1},
      "additionalProperties": {"type": "integer", "minimum": 0}
    }
  }
}
