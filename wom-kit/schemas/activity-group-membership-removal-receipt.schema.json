{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wom-kit/activity-group-membership-removal-receipt/v0.1",
  "title": "WOM-kit activity-group membership removal receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "action",
    "status",
    "applied_at",
    "archive_id",
    "request_sha256",
    "review_plan_sha256",
    "write_plan_sha256",
    "anchor_zettel_id",
    "reviewed_by",
    "human_affirmation",
    "item_count",
    "items",
    "mutation_contract",
    "privacy_guards"
  ],
  "properties": {
    "schema": {"const": "wom-kit/activity-group-membership-removal-receipt/v0.1"},
    "action": {"const": "activity_group_membership_removal_write"},
    "status": {"const": "applied"},
    "applied_at": {"type": "string", "minLength": 1},
    "archive_id": {"type": "string", "minLength": 1},
    "request_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "review_plan_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "write_plan_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "anchor_zettel_id": {"type": "string", "pattern": "^zet_[A-Za-z0-9][A-Za-z0-9_-]{0,159}$"},
    "reviewed_by": {"type": "string", "minLength": 1},
    "human_affirmation": {"const": "all_activity_group_membership_removals_reviewed"},
    "item_count": {"type": "integer", "minimum": 1, "maximum": 5000},
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {"$ref": "#/$defs/item"}
    },
    "mutation_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_changed",
        "anchor_changed",
        "body_bytes_preserved",
        "other_frontmatter_semantics_preserved",
        "updated_at_changed",
        "prior_byte_snapshots_verified_before_first_canonical_write",
        "rollback_on_runtime_failure",
        "crash_recovery_journal_written",
        "membership_inferred",
        "membership_removal_implemented"
      ],
      "properties": {
        "field_changed": {"const": "frontmatter.facets.activity_group"},
        "anchor_changed": {"const": false},
        "body_bytes_preserved": {"const": true},
        "other_frontmatter_semantics_preserved": {"const": true},
        "updated_at_changed": {"const": false},
        "prior_byte_snapshots_verified_before_first_canonical_write": {"const": true},
        "rollback_on_runtime_failure": {"const": true},
        "crash_recovery_journal_written": {"const": true},
        "membership_inferred": {"const": false},
        "membership_removal_implemented": {"const": true}
      }
    },
    "privacy_guards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_path_stored",
        "title_text_stored",
        "body_text_stored",
        "contains_private_zettel_ids_and_paths",
        "provider_api_called",
        "model_called",
        "network_called",
        "secret_store_or_environment_read"
      ],
      "properties": {
        "request_path_stored": {"const": false},
        "title_text_stored": {"const": false},
        "body_text_stored": {"const": false},
        "contains_private_zettel_ids_and_paths": {"const": true},
        "provider_api_called": {"const": false},
        "model_called": {"const": false},
        "network_called": {"const": false},
        "secret_store_or_environment_read": {"const": false}
      }
    }
  },
  "$defs": {
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_id",
        "logical_key",
        "size_bytes",
        "mime",
        "stored_sha256_verified",
        "manifest_registered"
      ],
      "properties": {
        "object_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "logical_key": {"type": "string", "pattern": "^objects/sha256/[0-9a-f]{2}/[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1, "maximum": 16777216},
        "mime": {"const": "text/markdown"},
        "stored_sha256_verified": {"const": true},
        "manifest_registered": {"const": true}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_index",
        "zettel_id",
        "canonical_path",
        "before_file_sha256",
        "after_file_sha256",
        "before_snapshot"
      ],
      "properties": {
        "row_index": {"type": "integer", "minimum": 0},
        "zettel_id": {"type": "string", "pattern": "^zet_[A-Za-z0-9][A-Za-z0-9_-]{0,159}$"},
        "canonical_path": {"type": "string", "pattern": "^zettels/zet_[A-Za-z0-9][A-Za-z0-9_-]{0,159}\\.md$"},
        "before_file_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "after_file_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "before_snapshot": {"$ref": "#/$defs/snapshot"}
      }
    }
  }
}
