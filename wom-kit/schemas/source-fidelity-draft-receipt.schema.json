{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wom-kit/source-fidelity-draft-receipt/v0.1",
  "title": "WOM-kit private source fidelity draft receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "action",
    "archive_id",
    "archive_type",
    "draft_id",
    "draft_path",
    "body_sha256",
    "creation_mode",
    "frontmatter_authority_sha256",
    "source_fidelity_plan_sha256",
    "reviewed_by",
    "review_binding_sha256",
    "candidate_created_at",
    "source_fidelity",
    "content_contract",
    "result"
  ],
  "properties": {
    "schema": {"const": "wom-kit/source-fidelity-draft-receipt/v0.1"},
    "action": {"const": "create_source_fidelity_draft"},
    "archive_id": {"type": "string", "minLength": 1},
    "archive_type": {"type": ["string", "null"]},
    "draft_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"},
    "draft_path": {"type": "string", "pattern": "^inbox/[A-Za-z0-9_-]+\\.md$"},
    "body_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "creation_mode": {"enum": ["ai_assisted", "ai_generated"]},
    "frontmatter_authority_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_fidelity_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewed_by": {"type": "string", "minLength": 1},
    "review_binding_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_created_at": {"type": "string", "minLength": 1},
    "source_fidelity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "mode",
        "audience",
        "comparison_basis",
        "source",
        "region",
        "byte_exact",
        "mechanically_verified",
        "semantic_fidelity_machine_verified",
        "human_review_required",
        "source_changed",
        "share_performed",
        "source_text_stored",
        "source_locator_stored",
        "creation_plan_sha256",
        "evidence_id"
      ],
      "properties": {
        "schema": {"const": "wom-kit/source-fidelity/v0.1"},
        "mode": {"enum": ["verbatim", "faithful_summary", "sanitized_derivative"]},
        "audience": {
          "enum": [
            "private_self",
            "ai_working_context",
            "client_report",
            "public_web",
            "legal_copyright_request"
          ]
        },
        "comparison_basis": {"const": "utf8_newlines_lf"},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "object_id",
            "raw_sha256",
            "raw_size_bytes",
            "normalized_sha256",
            "normalized_size_bytes",
            "comparison_basis",
            "newline_transformation_applied",
            "source_text_stored",
            "source_locator_stored"
          ],
          "properties": {
            "object_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "raw_size_bytes": {"type": "integer", "minimum": 0},
            "normalized_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "normalized_size_bytes": {"type": "integer", "minimum": 0},
            "comparison_basis": {"const": "utf8_newlines_lf"},
            "newline_transformation_applied": {"type": "boolean"},
            "source_text_stored": {"const": false},
            "source_locator_stored": {"const": false}
          }
        },
        "region": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["offset_bytes", "length_bytes", "sha256"],
              "properties": {
                "offset_bytes": {"type": "integer", "minimum": 0},
                "length_bytes": {"type": "integer", "minimum": 0},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          ]
        },
        "byte_exact": {"const": false},
        "mechanically_verified": {"type": "boolean"},
        "semantic_fidelity_machine_verified": {"const": false},
        "human_review_required": {"const": true},
        "source_changed": {"const": false},
        "share_performed": {"const": false},
        "source_text_stored": {"const": false},
        "source_locator_stored": {"const": false},
        "creation_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "evidence_id": {"type": "string", "pattern": "^source-fidelity-evidence:[0-9a-f]{24}$"}
      },
      "if": {
        "properties": {"mode": {"const": "verbatim"}},
        "required": ["mode"]
      },
      "then": {
        "properties": {
          "region": {"type": "object"},
          "mechanically_verified": {"const": true}
        }
      },
      "else": {
        "properties": {
          "region": {"type": "null"},
          "mechanically_verified": {"const": false}
        }
      }
    },
    "content_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_text_stored", "source_locator_stored", "source_path_stored"],
      "properties": {
        "source_text_stored": {"const": false},
        "source_locator_stored": {"const": false},
        "source_path_stored": {"const": false}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["draft_written_create_only", "receipt_written_create_only", "source_changed", "share_performed"],
      "properties": {
        "draft_written_create_only": {"const": true},
        "receipt_written_create_only": {"const": true},
        "source_changed": {"const": false},
        "share_performed": {"const": false}
      }
    }
  }
}
