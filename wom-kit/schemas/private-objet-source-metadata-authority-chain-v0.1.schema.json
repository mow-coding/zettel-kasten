{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wom-kit/private-objet-source-metadata-authority-chain/v0.1",
  "title": "WOM-kit private objet source metadata authority chain v0.1",
  "type": "object",
  "required": [
    "schema",
    "private_manifest_state",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "wom-kit/private-objet-source-metadata-authority-chain/v0.1"
    },
    "private_manifest_state": {
      "$ref": "#/$defs/fileState"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "fileState": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "state",
            "sha256",
            "byte_count",
            "row_count",
            "link_count"
          ],
          "properties": {
            "state": {
              "const": "absent"
            },
            "sha256": {
              "const": null
            },
            "byte_count": {
              "type": "integer",
              "const": 0
            },
            "row_count": {
              "type": "integer",
              "const": 0
            },
            "link_count": {
              "type": "integer",
              "const": 0
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "state",
            "sha256",
            "byte_count",
            "row_count",
            "link_count"
          ],
          "properties": {
            "state": {
              "const": "present"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "byte_count": {
              "$ref": "#/$defs/nonNegativeInteger"
            },
            "row_count": {
              "$ref": "#/$defs/nonNegativeInteger"
            },
            "link_count": {
              "$ref": "#/$defs/nonNegativeInteger"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "state",
            "sha256",
            "byte_count",
            "row_count",
            "link_count"
          ],
          "properties": {
            "state": {
              "const": "present_invalid"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "byte_count": {
              "$ref": "#/$defs/nonNegativeInteger"
            },
            "row_count": {
              "const": null
            },
            "link_count": {
              "$ref": "#/$defs/nonNegativeInteger"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "state",
            "sha256",
            "byte_count",
            "row_count",
            "link_count"
          ],
          "properties": {
            "state": {
              "const": "unavailable"
            },
            "sha256": {
              "const": null
            },
            "byte_count": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/nonNegativeInteger"
                }
              ]
            },
            "row_count": {
              "const": null
            },
            "link_count": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/nonNegativeInteger"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "entry": {
      "type": "object",
      "required": [
        "row_number",
        "intake_sha256",
        "canonical_row_sha256",
        "observation_evidence_sha256",
        "review_evidence_sha256",
        "authority_key_sha256",
        "receipt_relative_path",
        "receipt_sha256",
        "manifest_before",
        "manifest_after"
      ],
      "properties": {
        "row_number": {
          "type": "integer",
          "minimum": 1
        },
        "intake_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonical_row_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "observation_evidence_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "review_evidence_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "authority_key_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "receipt_relative_path": {
          "type": "string",
          "pattern": "^receipts/objects/private-source-metadata/[0-9a-f]{64}\\.json$"
        },
        "receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "manifest_before": {
          "$ref": "#/$defs/fileState"
        },
        "manifest_after": {
          "$ref": "#/$defs/fileState"
        }
      },
      "additionalProperties": false
    }
  }
}
