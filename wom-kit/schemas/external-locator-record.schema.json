{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wom-kit/external-locator-record/v0.2",
  "title": "WOM-kit provider-neutral external locator record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "archive_id", "zettel_id", "created_at", "updated_at", "locators"],
  "properties": {
    "schema": {"const": "wom-kit/external-locator-record/v0.2"},
    "archive_id": {"type": "string", "minLength": 1},
    "zettel_id": {"type": "string", "pattern": "^zet_[A-Za-z0-9][A-Za-z0-9_-]{0,159}$"},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1},
    "locators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["locator_id", "locator_type", "locator_ref", "status", "recorded_at", "reviewed_by", "provenance"],
        "properties": {
          "locator_id": {"type": "string", "pattern": "^locator:sha256:[0-9a-f]{64}$"},
          "locator_type": {"enum": ["source_url", "provider_page_id", "object_store_key", "filesystem_hint", "export_coordinate", "other"]},
          "locator_ref": {"type": "string", "minLength": 1, "maxLength": 4096},
          "service_ref": {"type": "string", "minLength": 1, "maxLength": 120},
          "account_ref": {"type": "string", "minLength": 1, "maxLength": 320},
          "occurrence_anchor": {"type": "string", "minLength": 1, "maxLength": 240},
          "status": {"const": "active"},
          "recorded_at": {"type": "string", "minLength": 1},
          "reviewed_by": {"type": "string", "minLength": 1},
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "automatic_recovery_claimed"],
            "properties": {
              "source": {"const": "human_reviewed_cli"},
              "automatic_recovery_claimed": {"const": false}
            }
          }
        }
      }
    }
  }
}
